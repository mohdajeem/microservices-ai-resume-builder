# Ignore everything
/*

# But include these folders
!/backend/
!/client/
!/learning/
!/.github/

# Root files to include
!/.gitignore
!/README.md
!/Dockerfile.prod.example
!/docker-compose.example.yml
docker-compose.yml
!/INTERVIEW_PREP_SYLLABUS.md
!/RESUME_BULLET_POINTS.md
!/TECHNICAL_DEEP_DIVE_ANSWERS.md
!/test_ai_service.py

# Environment files - CRITICAL: Never commit .env files
**/.env
**/.env.*
!**/.env.example

# Node modules
**/node_modules/
**/package-lock.json

# Build and IDE outputs
**/dist/
**/build/
**/.vs/
**/.vscode/
**/target/
**/out/

# System files
.DS_Store
Thumbs.db

# Service specific ignores
**/renders/
**/pdf-parsing-worker/node_modules/

INTERVIEW_PREP_SYLLABUS.md
RESUME_BULLET_POINTS.md
TECHNICAL_DEEP_DIVE_ANSWERS.md
